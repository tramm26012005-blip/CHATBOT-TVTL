DATABASE_URL=postgresql+psycopg://tuvantamly:change-this-password@localhost:5432/tuvantamly
OPENAI_API_KEY=
# Set explicitly to models enabled for your OpenAI project.
OPENAI_CHAT_MODEL=
OPENAI_TRANSCRIBE_MODEL=
OPENAI_TTS_MODEL=
# Enable only when the selected speech model supports the instructions parameter.
OPENAI_TTS_INSTRUCTIONS_SUPPORTED=false
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
ALLOW_DRAFT_ASSESSMENT=false
ASSESSMENT_RIGHTS_VERIFIED=false
ASSESSMENT_CLINICAL_REVIEWED=false
DAILY_AI_REQUEST_LIMIT=60
DAILY_SERVICE_REQUEST_LIMIT=1000
MAX_VOICE_BYTES=5242880
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Generate a random secret of at least 32 characters. Never share this key.
OTP_SECRET_KEY=

# Enable only for local demo; never interprets a click as real payment.
MEMBERSHIP_DEMO_ENABLED=false

# Real VIP payments. Keep disabled until both provider setup and live checks are complete.
# Values below are server-only. Never use NEXT_PUBLIC_ for these keys.
PAYMENTS_ENABLED=false
# Public HTTPS origin routing /api to this backend (no trailing path).
PAYMENT_PUBLIC_ORIGIN=
# payOS payment channel linked to the intended MB Bank receiving account.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
MB_ACCOUNT_NUMBER=
# Production merchant credentials from MoMo for Business; personal QR is insufficient.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# Local book retrieval; build once with scripts/index_books.py after changing PDFs.
BOOK_KNOWLEDGE_ENABLED=true

AI_PROVIDER=gemini

GEMINI_API_KEY=

GEMINI_CHAT_MODEL=gemini-3.6-flash

GEMINI_TRANSCRIBE_MODEL=gemini-3.6-flash

GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
